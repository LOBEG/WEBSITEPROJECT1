VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# Telegram (optional) — delivers contact-form leads to a Telegram chat via the Bot API
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token
VITE_TELEGRAM_CHAT_ID=your_telegram_chat_id
# Public Telegram chat link shown in the "Telegram Chat" quick-contact button
VITE_TELEGRAM_CONTACT_URL=https://t.me/your_handle

# WhatsApp (optional) — number (digits only, incl. country code) used for the
# "Send via WhatsApp" deep link. Defaults to 17134281255 when unset.
VITE_WHATSAPP_NUMBER=17134281255
